# Generate both of these by running: npm run set-admin-password
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Supabase project settings (Dashboard -> Project Settings -> API)
# SUPABASE_URL and NEXT_PUBLIC_SUPABASE_URL are the same value, just needed
# under both names because one is read server-side and one is sent to the
# browser (NEXT_PUBLIC_ prefix is required for that, by Next.js convention).
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
# Secret. Server-only. Never put this one behind NEXT_PUBLIC_ or send it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Safe to expose publicly — this key can only do what supabase/schema.sql's RLS policies allow.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Meta WhatsApp Cloud API (Meta for Developers -> your app -> WhatsApp -> API Setup).
# In the sandbox, these come from the "Temporary access token" and the test
# phone number ID shown on that page.
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=

# Shared secret Supabase Database Webhooks must send back as the
# x-webhook-secret header. Generate any long random string.
WEBHOOK_SECRET=
